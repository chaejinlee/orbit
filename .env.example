# Copy to .env at the repo root. Every app loads this file.

# Local Postgres. `npm run db:start` runs an embedded Postgres on this port (no Docker needed).
DATABASE_URL=postgresql://orbit:orbit@localhost:5433/orbit

# Signs session tokens shared by the API and the realtime server.
# Use a long random value outside local development.
AUTH_SECRET=dev-only-change-me-0123456789abcdef

# Enables the passwordless development sign-in. Never enable in production.
AUTH_DEV_LOGIN=true

API_PORT=4000
REALTIME_PORT=4001
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Keep these on localhost: a phone that opens Orbit at this computer's Wi-Fi
# address reaches the API and realtime servers at that same address.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_REALTIME_URL=ws://localhost:4001

# Which network interface the servers listen on. 127.0.0.1 = this computer only
# (default). `npm run dev:phone` uses 0.0.0.0 for one run so a phone on the same
# Wi-Fi can open Orbit; other devices then need the 6-digit code shown under
# "Open on your phone" to sign in, because the dev sign-in has no password.
BIND_HOST=127.0.0.1

# Where photo files are kept. Default: .data/uploads in this folder, next to the
# local database. A deployment needs a persistent disk here, or object storage.
# UPLOADS_DIR=

# ── Orbit AI (Google Gemini) ──────────────────────────────────────────────
# Free key, no credit card: https://aistudio.google.com/api-keys
# Paste it here yourself (never into a chat). Leave empty to keep AI off.
# On the free tier Google may use prompts and answers to improve its products,
# so don't send real personal data until the project has billing enabled.
GEMINI_API_KEY=
# Google's current stable Flash-Lite. The free tier covers plain calls only:
# answers that cite Google Maps / Search need billing on the key (5,000 a month
# free, then $14 per 1,000). gemini-2.5-flash-lite is closed to new keys.
GEMINI_MODEL=gemini-3.5-flash-lite
# AI calls one person may make per rolling 24 hours.
AI_DAILY_LIMIT=40
# gemini (default when a key is set) | fake (canned answers for UI work, dev only) | off
AI_PROVIDER=
