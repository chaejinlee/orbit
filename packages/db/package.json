{
  "name": "@orbit/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Postgres schema, migrations, Prisma client and server-only access helpers.",
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "db:start": "tsx scripts/dev-db.ts",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx src/seed.ts",
    "postinstall": "prisma generate",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@orbit/shared": "*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "embedded-postgres": "18.6.0-beta.19",
    "jose": "6.2.15",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "prisma": "7.10.1"
  }
}
